<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="daren-api" stopProcessing="true">
          <match url="^api(/.*)?$" />
          <action type="Rewrite" url="api/index.php" appendQueryString="true" />
        </rule>
        <rule name="daren-files" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{DOCUMENT_ROOT}/frontend/{R:1}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="frontend/{R:1}" />
        </rule>
        <rule name="daren-home" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="frontend/index.html" />
        </rule>
      </rules>
    </rewrite>
    <defaultDocument>
      <files>
        <add value="frontend/index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
